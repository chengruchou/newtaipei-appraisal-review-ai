{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Independent rehearsal dashboard, aggregate query and notification alarms for exact campaign and deployment metrics.",
  "Metadata": {
    "com.aws.cloudformation.Context": {
      "ref": [
        "../../docs/cloud-acceptance.md"
      ],
      "must": [
        "Deploy only to the authorized sandbox.",
        "This stack does not create evidence or install metric publishers."
      ]
    }
  },
  "Parameters": {
    "CampaignId": {
      "Type": "String",
      "AllowedPattern": "^r-[a-f0-9]{32}$",
      "Description": "Pinned rehearsal CampaignId. No private labels."
    },
    "CodeCommit": {
      "Type": "String",
      "AllowedPattern": "^[a-f0-9]{40}$",
      "Description": "Pinned rehearsal CodeCommit. No private labels."
    },
    "ImageDigest": {
      "Type": "String",
      "AllowedPattern": "^[a-f0-9]{64}$",
      "Description": "Pinned rehearsal ImageDigest. No private labels."
    },
    "PullRequestNumber": {
      "Type": "Number",
      "MinValue": 1,
      "MaxValue": 1000000000,
      "Description": "Pinned rehearsal PullRequestNumber. No private labels."
    },
    "OwnerAlias": {
      "Type": "String",
      "AllowedPattern": "^r-[a-f0-9]{32}$",
      "Description": "Pinned rehearsal OwnerAlias. No private labels."
    },
    "ExpiryEpoch": {
      "Type": "Number",
      "MinValue": 1,
      "Description": "Pinned rehearsal ExpiryEpoch. No private labels."
    },
    "WorkQueueName": {
      "Type": "String",
      "AllowedPattern": "^[A-Za-z0-9_-]{1,80}$",
      "Description": "Exact owned standard work queue from the deployment inventory."
    },
    "DeadLetterQueueName": {
      "Type": "String",
      "AllowedPattern": "^[A-Za-z0-9_-]{1,80}$",
      "Description": "Exact owned standard dead-letter queue from the deployment inventory."
    },
    "RuntimeLogGroupName": {
      "Type": "String",
      "AllowedPattern": "^[./A-Za-z0-9_-]{1,512}$",
      "Description": "Existing value-free structured operational log group. Retention is managed by deployment."
    },
    "AlarmTopicArn": {
      "Type": "String",
      "AllowedPattern": "^arn:(aws|aws-us-gov|aws-cn):sns:[a-z0-9-]+:[0-9]{12}:[A-Za-z0-9_-]+$",
      "Description": "Existing approved notification topic in the selected account and Region."
    },
    "QueueAgeSeconds": {
      "Type": "Number",
      "Default": 120,
      "MinValue": 1,
      "MaxValue": 86400,
      "Description": "Pinned rehearsal QueueAgeSeconds. No private labels."
    },
    "JobLatencySeconds": {
      "Type": "Number",
      "Default": 300,
      "MinValue": 1,
      "MaxValue": 86400,
      "Description": "Pinned rehearsal JobLatencySeconds. No private labels."
    },
    "ModelLatencyMilliseconds": {
      "Type": "Number",
      "Default": 30000,
      "MinValue": 1,
      "MaxValue": 3600000,
      "Description": "Pinned rehearsal ModelLatencyMilliseconds. No private labels."
    },
    "WaitingTaskThreshold": {
      "Type": "Number",
      "Default": 5,
      "MinValue": 1,
      "MaxValue": 1000,
      "Description": "Pinned rehearsal WaitingTaskThreshold. No private labels."
    }
  },
  "Resources": {
    "QueueAgeAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-QueueAgeAlarm"
        },
        "AlarmDescription": {
          "Fn::Sub": "Owner ${OwnerAlias}; follow docs/cloud-acceptance.md#alarm-response; campaign ${CampaignId}."
        },
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateAgeOfOldestMessage",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Ref": "WorkQueueName"
            }
          }
        ],
        "Period": 60,
        "EvaluationPeriods": 3,
        "DatapointsToAlarm": 2,
        "Threshold": {
          "Ref": "QueueAgeSeconds"
        },
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "missing",
        "AlarmActions": [
          {
            "Ref": "AlarmTopicArn"
          }
        ],
        "OKActions": [
          {
            "Ref": "AlarmTopicArn"
          }
        ],
        "InsufficientDataActions": [
          {
            "Ref": "AlarmTopicArn"
          }
        ],
        "ActionsEnabled": true,
        "Tags": [
          {
            "Key": "project",
            "Value": "appraisal-review"
          },
          {
            "Key": "environment",
            "Value": "rehearsal"
          },
          {
            "Key": "owner",
            "Value": {
              "Ref": "OwnerAlias"
            }
          },
          {
            "Key": "expiry",
            "Value": {
              "Ref": "ExpiryEpoch"
            }
          },
          {
            "Key": "campaign",
            "Value": {
              "Ref": "CampaignId"
            }
          },
          {
            "Key": "pull-request",
            "Value": {
              "Ref": "PullRequestNumber"
            }
          }
        ],
        "Statistic": "Maximum"
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Detect rehearsal regression with bounded notification only.",
          "must": [
            "Missing observations cannot establish acceptance.",
            "No automatic redrive, deletion or rollback action."
          ]
        }
      }
    },
    "DeadLetterAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
