{
  "$defs": {
    "DocumentErrorCode": {
      "enum": [
        "document_invalid_request",
        "document_unauthorized",
        "document_privacy_attestation_invalid",
        "document_too_large",
        "document_not_pdf",
        "document_not_found",
        "document_version_conflict",
        "document_integrity_failure",
        "document_capability_unavailable"
      ],
      "title": "DocumentErrorCode",
      "type": "string"
    },
    "DocumentMetadata": {
      "additionalProperties": false,
      "properties": {
        "attestation": {
          "$ref": "#/$defs/PrivacyAttestation"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "classification": {
          "const": "sanitized",
          "default": "sanitized",
          "title": "Classification",
          "type": "string"
        },
        "content_type": {
          "const": "application/pdf",
          "default": "application/pdf",
          "title": "Content Type",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/DocumentReference"
        },
        "schema_version": {
          "const": "document-v1",
          "default": "document-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "uploaded_by": {
          "format": "uuid4",
          "title": "Uploaded By",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "attestation",
        "uploaded_by",
        "created_at",
        "byte_size"
      ],
      "title": "DocumentMetadata",
      "type": "object"
    },
    "DocumentProblem": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/DocumentErrorCode"
        },
        "message": {
          "const": "Document operation could not be completed.",
          "default": "Document operation could not be completed.",
          "title": "Message",
          "type": "string"
        },
        "schema_version": {
          "const": "document-v1",
          "default": "document-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "DocumentProblem",
      "type": "object"
    },
    "DocumentReference": {
      "additionalProperties": false,
      "description": "External identity: no caller-selected storage URI or asserted authority.",
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Case Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "document_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Document Id",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "criteria",
            "forms",
            "reference",
            "brief",
            "template"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "const": "service-v1",
          "default": "service-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "document_id",
        "version",
        "content_hash",
        "purpose"
      ],
      "title": "DocumentReference",
      "type": "object"
    },
    "ExportClaims": {
      "additionalProperties": false,
      "description": "Signed by an operator-provisioned local export gate after exact human consent.",
      "properties": {
        "confirmed_at": {
          "format": "date-time",
          "title": "Confirmed At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "export_id": {
          "format": "uuid4",
          "title": "Export Id",
          "type": "string"
        },
        "key_id": {
          "format": "uuid4",
          "title": "Key Id",
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/PrivacyManifest"
        },
        "previous": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "principal_id": {
          "format": "uuid4",
          "title": "Principal Id",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "criteria",
            "forms",
            "reference",
            "brief",
            "template"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "const": "document-export-v1",
          "default": "document-export-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "export_id",
        "principal_id",
        "manifest",
        "purpose",
        "confirmed_at",
        "expires_at"
      ],
      "title": "ExportClaims",
      "type": "object"
    },
    "PlaceholderOccurrence": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "format": "uuid4",
          "title": "Entity Id",
          "type": "string"
        },
        "occurrence_id": {
          "format": "uuid4",
          "title": "Occurrence Id",
          "type": "string"
        },
        "region": {
          "$ref": "#/$defs/PrivacyRegion"
        }
      },
      "required": [
        "occurrence_id",
        "entity_id",
        "region"
      ],
      "title": "PlaceholderOccurrence",
      "type": "object"
    },
    "PrivacyAttestation": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "default": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "claims": {
          "$ref": "#/$defs/ExportClaims"
        },
        "signature_hex": {
          "pattern": "^[a-f0-9]{128}$",
          "title": "Signature Hex",
          "type": "string"
        }
      },
      "required": [
        "claims",
        "signature_hex"
      ],
      "title": "PrivacyAttestation",
      "type": "object"
    },
    "PrivacyManifest": {
      "additionalProperties": false,
      "description": "Allowlisted sanitized identity only; DTO validity does not permit upload.\n\nIDs must be issued randomly by the future trusted adapter. UUID shape cannot\nprove randomness. Repeated entity IDs are legal; occurrence IDs are unique.",
      "properties": {
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "case_id": {
          "format": "uuid4",
          "title": "Case Id",
          "type": "string"
        },
        "document_id": {
          "format": "uuid4",
          "title": "Document Id",
          "type": "string"
        },
        "filename": {
          "const": "sanitized.pdf",
          "default": "sanitized.pdf",
          "title": "Filename",
          "type": "string"
        },
        "media_type": {
          "const": "application/pdf",
          "default": "application/pdf",
          "title": "Media Type",
          "type": "string"
        },
        "occurrences": {
          "items": {
            "$ref": "#/$defs/PlaceholderOccurrence"
          },
          "title": "Occurrences",
          "type": "array"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/PrivacyPage"
          },
          "minItems": 1,
          "title": "Pages",
          "type": "array"
        },
        "policy_version": {
          "const": "privacy-policy-v1",
          "default": "privacy-policy-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "processor_version": {
          "const": "privacy-processor-v1",
          "default": "privacy-processor-v1",
          "title": "Processor Version",
          "type": "string"
        },
        "sanitized_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sanitized Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "privacy-v1",
          "default": "privacy-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "document_id",
        "sanitized_digest",
        "byte_size",
        "pages",
        "occurrences"
      ],
      "title": "PrivacyManifest",
      "type": "object"
    },
    "PrivacyPage": {
      "additionalProperties": false,
      "properties": {
        "coordinate_system": {
          "const": "pdf_bottom_left",
          "default": "pdf_bottom_left",
          "title": "Coordinate System",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "page_space": {
          "const": "unrotated_crop_box",
          "default": "unrotated_crop_box",
          "title": "Page Space",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "number",
        "width",
        "height"
      ],
      "title": "PrivacyPage",
      "type": "object"
    },
    "PrivacyRegion": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        }
      },
      "required": [
        "page",
        "bbox"
      ],
      "title": "PrivacyRegion",
      "type": "object"
    },
    "RevisionReference": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Case Id",
          "type": "string"
        },
        "material_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Material Digest",
          "type": "string"
        },
        "revision_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Revision Id",
          "type": "string"
        },
        "schema_version": {
          "const": "service-v1",
          "default": "service-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "revision_id",
        "material_digest"
      ],
      "title": "RevisionReference",
      "type": "object"
    },
    "RunSourceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "format": "uuid4",
          "title": "Created By",
          "type": "string"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/SnapshotEntry"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Documents",
          "type": "array"
        },
        "revision": {
          "$ref": "#/$defs/RevisionReference"
        },
        "run_id": {
          "format": "uuid4",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "document-snapshot-v1",
          "default": "document-snapshot-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "revision",
        "created_at",
        "created_by",
        "documents"
      ],
      "title": "RunSourceSnapshot",
      "type": "object"
    },
    "SnapshotEntry": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "$ref": "#/$defs/DocumentReference"
        },
        "page_count": {
          "exclusiveMinimum": 0,
          "title": "Page Count",
          "type": "integer"
        },
        "privacy_manifest_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Privacy Manifest Digest",
          "type": "string"
        },
        "stored_document_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Stored Document Digest",
          "type": "string"
        }
      },
      "required": [
        "document",
        "privacy_manifest_digest",
        "stored_document_digest",
        "page_count"
      ],
      "title": "SnapshotEntry",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authorized sanitized document contracts"
}
