      "required": [
        "code",
        "message"
      ],
      "title": "VerificationDiagnostic",
      "type": "object"
    },
    "WorkflowStatus": {
      "enum": [
        "received",
        "needs_review",
        "verified",
        "completed",
        "failed"
      ],
      "title": "WorkflowStatus",
      "type": "string"
    }
