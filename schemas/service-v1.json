            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        }
