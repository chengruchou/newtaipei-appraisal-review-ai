    "VerificationDiagnostic": {
      "additionalProperties": false,
      "description": "Finite public reasons; never carry raw internal verification messages.",
      "properties": {
        "schema_version": {
          "const": "service-v1",
          "default": "service-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "code": {
          "enum": [
            "source_binding",
            "source_registry_required",
