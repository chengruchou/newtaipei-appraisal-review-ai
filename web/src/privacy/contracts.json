            "title": "Schema Version",
            "type": "string"
          },
          "snapshot_id": {
            "format": "uuid4",
            "title": "Snapshot Id",
            "type": "string"
          }
        },
        "required": ["case_id", "snapshot_id", "revision", "candidate_id", "reason"],
        "title": "RemovePrivacyRegion",
        "type": "object"
      },
      "ReviewPrivacyPage": {
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "format": "uuid4",
            "title": "Case Id",
            "type": "string"
          },
          "page": {
            "minimum": 1,
            "title": "Page",
            "type": "integer"
          },
          "revision": {
            "minimum": 1,
            "title": "Revision",
            "type": "integer"
          },
          "schema_version": {
            "const": "local-privacy-v1",
            "default": "local-privacy-v1",
            "title": "Schema Version",
            "type": "string"
          },
          "snapshot_id": {
            "format": "uuid4",
            "title": "Snapshot Id",
            "type": "string"
          }
        },
        "required": ["case_id", "snapshot_id", "revision", "page"],
        "title": "ReviewPrivacyPage",
        "type": "object"
      },
      "ReviewSelection": {
        "additionalProperties": false,
        "description": "Complete local review set, including explicitly dismissed detections.",
        "properties": {
          "candidate": {
            "$ref": "#/components/schemas/SensitiveCandidate"
          },
          "dismissal_reason": {
            "anyOf": [
              {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Dismissal Reason"
          },
          "disposition": {
            "enum": ["redact", "dismiss"],
            "title": "Disposition",
            "type": "string"
          },
          "entity_id": {
            "anyOf": [
              {
                "format": "uuid4",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Entity Id"
          },
          "schema_version": {
            "const": "local-privacy-v1",
            "default": "local-privacy-v1",
            "title": "Schema Version",
            "type": "string"
