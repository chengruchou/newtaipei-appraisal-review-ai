        "title": "ScanIssue",
        "type": "string"
      },
      "SensitiveCandidate": {
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "format": "uuid4",
            "title": "Candidate Id",
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/SensitiveCategory"
          },
          "confidence": {
            "anyOf": [
              {
                "maximum": 1,
