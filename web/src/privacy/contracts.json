{
  "components": {
    "schemas": {
      "AddPrivacyRegion": {
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "format": "uuid4",
            "title": "Case Id",
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/SensitiveCategory"
          },
          "region": {
            "$ref": "#/components/schemas/PrivacyRegion"
          },
          "revision": {
            "minimum": 1,
            "title": "Revision",
            "type": "integer"
          },
          "schema_version": {
            "const": "local-privacy-v1",
            "default": "local-privacy-v1",
            "title": "Schema Version",
            "type": "string"
          },
          "snapshot_id": {
            "format": "uuid4",
            "title": "Snapshot Id",
            "type": "string"
          }
        },
        "required": ["case_id", "snapshot_id", "revision", "region", "category"],
        "title": "AddPrivacyRegion",
        "type": "object"
      },
      "ConfirmPrivacyReview": {
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "format": "uuid4",
            "title": "Case Id",
            "type": "string"
          },
          "review_digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Review Digest",
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "title": "Revision",
            "type": "integer"
          },
          "schema_version": {
            "const": "local-privacy-v1",
            "default": "local-privacy-v1",
            "title": "Schema Version",
            "type": "string"
          },
          "snapshot_id": {
            "format": "uuid4",
            "title": "Snapshot Id",
            "type": "string"
          }
        },
        "required": ["case_id", "snapshot_id", "revision", "review_digest"],
        "title": "ConfirmPrivacyReview",
        "type": "object"
      },
      "EditPrivacyRegion": {
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "format": "uuid4",
            "title": "Candidate Id",
